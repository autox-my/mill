# Copy to /etc/mill/mill.env (chmod 0640, chown root:mill) — never commit secrets.
MILL_DB=/var/lib/mill/mill.db
MILL_ADDR=127.0.0.1:8080
MILL_API_TOKEN=replace-with-openssl-rand-hex-32

# Optional: only needed for `mill improve` with an external OpenAI-compatible API.
# `mill serve` does not use these, and `mill improve --report-only` feeds directly into
# Antigravity, Claude Code, or OpenCode without any external LLM gateway.
# MILL_LLM_BASE_URL=https://api.openai.com/v1
# MILL_LLM_API_KEY=replace-with-api-key
# MILL_LLM_MODEL=replace-with-model-id
