# Copy to /etc/mill/mill.env (chmod 0600, chown root:mill) — never commit secrets.
MILL_DB=/var/lib/mill/mill.db
MILL_ADDR=127.0.0.1:8080
MILL_API_TOKEN=replace-with-openssl-rand-hex-32

# Optional: outer-loop observer LLM via OmniRoute (CT 113)
MILL_LLM_BASE_URL=https://omniroute.xantu-barb.ts.net/v1
MILL_LLM_API_KEY=replace-with-omniroute-key
MILL_LLM_MODEL=replace-with-model-id
